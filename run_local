#!/bin/bash
# Local run: rank 0 is the kMC master, the other ranks are ML-FF workers (cores_per_worker in main.py).
# Run it from the directory with the input files
# Usage: ./run_local [number of MPI ranks, default 3]

DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="${VENV:-$DIR/.venv}"  # Python environment. Set VENV to use another one

# The pip-installed MPICH (libmpi.so.12) that LAMMPS links to is in $VENV/lib
export LD_LIBRARY_PATH="$VENV/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

export OMP_NUM_THREADS=1
export DP_INTRA_OP_PARALLELISM_THREADS=1
export DP_INTER_OP_PARALLELISM_THREADS=1
export TF_INTRA_OP_PARALLELISM_THREADS=1
export TF_INTER_OP_PARALLELISM_THREADS=1
export TF_CPP_MIN_LOG_LEVEL=2

"$VENV/bin/mpirun" -np "${1:-3}" "$VENV/bin/python" -u -m mpi4py "$DIR/main.py" > out.txt 2> error
